# ============================================================
# Arquivo de exemplo — copie para .env e preencha os valores.
# O arquivo .env NUNCA deve ser commitado no Git.
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_BASE_URL=http://localhost:3001
APP_PUBLIC_BASE_URL=http://localhost:3001

# ── CORS ─────────────────────────────────────────────────────
# Em produção, liste as origens permitidas separadas por vírgula.
CORS_ORIGIN=http://localhost:3001

# ── Segurança (OBRIGATÓRIO) ───────────────────────────────────
# JWT_SECRET é OBRIGATÓRIO em todos os ambientes.
# Gere um valor forte com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
PASSWORD_SALT_ROUNDS=12

ENABLE_SETUP_ROUTE=false
# SETUP_KEY só é necessário se ENABLE_SETUP_ROUTE=true
SETUP_KEY=

# ── Banco de dados ────────────────────────────────────────────
# Opção A: SQLite (desenvolvimento local — padrão se nenhuma outra for definida)
# Sem configuração adicional necessária.

# Opção B: MySQL/MariaDB (cPanel, Railway, etc.)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=seu_usuario
# DB_PASSWORD=sua_senha_forte
# DB_NAME=nome_do_banco
# DB_CONNECTION_LIMIT=10

# Opção C: URL de conexão completa (Railway, PlanetScale, etc.)
# DATABASE_URL=mysql://usuario:senha@host:3306/banco

# Opção D: PostgreSQL (Neon, Supabase, etc.)
# DATABASE_URL=postgresql://usuario:senha@host.neon.tech:5432/banco?sslmode=require

# ── SMTP (opcional) ──────────────────────────────────────────
# Se não configurado, e-mails são apenas logados no console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LDFP Sistema <no-reply@seudominio.com>"

# ── Mercado Pago (opcional) ───────────────────────────────────
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# E-mail padrão do pagador quando não informado pelo cliente
MP_DEFAULT_PAYER_EMAIL=

# Chave PIX (obrigatória se usar cobrança PIX manual)
PIX_KEY=
PIX_RECEIVER_NAME=
PIX_RECEIVER_CITY=

# ── Deploy via GitHub Webhook (opcional) ─────────────────────
GITHUB_WEBHOOK_SECRET=
# Caminho absoluto do projeto no servidor (ex: /home/usuario/meusite.com.br)
DEPLOY_DIR=
DEPLOY_BRANCH=main

# ── Web Push / VAPID (opcional) ──────────────────────────────
# As chaves são geradas automaticamente no banco na primeira execução.
# Defina VAPID_SUBJECT com seu e-mail de contato real.
VAPID_SUBJECT=mailto:contato@seudominio.com

# ── WhatsApp ─────────────────────────────────────────────────
WHATSAPP_PROVIDER=mock
