{
  "name": "ldfp-gestao",
  "version": "1.0.0",
  "description": "LDFP Gestão — Plataforma SaaS para igrejas",
  "main": "src/server.js",
  "scripts": {
    "up": "npm run dev",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:ctrlf5": "nodemon --watch src --watch public --ext js,json,html,css src/server.js",
    "restart:cpanel": "mkdir -p tmp && touch tmp/restart.txt",
    "init:db": "node scripts/init-db.js",
    "check:db": "node scripts/check-db.js",
    "check:prod": "node scripts/check-production.js",
    "migrate": "node scripts/migrar-schema.js",
    "fix:db": "node scripts/fixDb.js",
    "backup:db": "node scripts/backup-db.js",
    "restore:db": "node scripts/restore-db.js",
    "gatilho:init": "node scripts/gatilho-retomada.js init-today",
    "gatilho:save": "node scripts/gatilho-retomada.js save",
    "gatilho:resume": "node scripts/gatilho-retomada.js resume",
    "seed:superadmin": "node scripts/seedSuperAdmin.js",
    "seed:planos": "node scripts/seed-planos.js",
    "build": "node scripts/build-public.js",
    "build:prod": "node scripts/build-public.js",
    "validate": "node scripts/validate-cpanel-ready.js",
    "stop": "echo 'Use CTRL+C para parar o servidor.'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clean-css": "^5.3.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "html-minifier-terser": "^7.2.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^2.12.0",
    "mysql2": "^3.17.4",
    "nodemailer": "^6.10.1",
    "pg": "^8.20.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "terser": "^5.43.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
