# Páginas, scripts e estilos: o navegador sempre confere com o servidor se há
# versão nova (resposta 304 rápida quando não mudou). Sem isso, depois de um
# deploy o navegador continua mostrando telas antigas.
<IfModule mod_headers.c>
    <FilesMatch "\.(html?|js|css|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-store, max-age=0"
    </FilesMatch>
</IfModule>
